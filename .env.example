# STATUS: NEW (PR 10, Bob to review). example environment for the Step 10 real AI assistant.
#
# copy this file to `.env` at the repo root and fill in your own values. the real `.env` is gitignored
# and must NEVER be committed (a real GEMINI_API_KEY is a secret). these are PLACEHOLDERS only - there
# is no real key here. os.environ (a shell export) always wins over the .env file.
#
# DEMO mode needs NONE of this: it uses no key and no internet and never calls an AI provider. these
# vars matter only in REAL mode (HDEV_MODE=real).

# which backend to use. 'gemini' (Google Gemini Developer API, free tier) is the default; 'ollama' is
# a local, fully offline model. switch backends by changing ONLY this line - no code change is needed.
AI_PROVIDER=gemini

# --- Gemini (default backend) --------------------------------------------------------------------
# get a free key from Google AI Studio (https://aistudio.google.com/apikey) and paste it here. the key
# is sent in the x-goog-api-key request header only; it is never logged or printed.
GEMINI_API_KEY=your-key-from-google-ai-studio
# a Flash model on the free tier at build time. documented in the README.
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local, offline backend) -------------------------------------------------------------
# the local Ollama daemon URL (default) and the model to use. nothing leaves your machine with ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# --- data guard (free-tier Gemini) ---------------------------------------------------------------
# the Gemini free tier may use inputs to improve Google's products. every project carries a
# client_data flag (default true). the server REFUSES to send a client-data project to the gemini
# backend unless ONE of these is set. ollama is always allowed (it is local).
#   set this to true to accept the free-tier terms and allow a client-data project on gemini anyway.
ALLOW_CLIENT_DATA_ON_FREE_TIER=false
#   set this to true when you move to a PAID Gemini key (the paid tier does not train on your inputs);
#   it lifts the data guard.
GEMINI_PAID=false
